
QMainWindow, QWidget {
    background: #1f2329;
    color: #e6edf3;
    font-family: "Segoe UI", "Yu Gothic UI", "Meiryo", sans-serif;
    font-size: 10pt;
}
QMenuBar {
    background: #252a31;
    border-bottom: 1px solid #3a404a;
}
QMenuBar::item {
    padding: 6px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected { background: #334155; }
QMenu {
    background: #252a31;
    border: 1px solid #3a404a;
}
QMenu::item {
    padding: 6px 22px;
    border-radius: 4px;
}
QMenu::item:selected { background: #334155; }
QToolBar {
    background: #252a31;
    border: 1px solid #3a404a;
    spacing: 4px;
    padding: 4px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 8px;
}
QToolButton:hover {
    background: #2f3947;
    border: 1px solid #4a6480;
}
QToolButton:pressed {
    background: #224b7a;
    border: 1px solid #6ba5ff;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #11161c;
    border: 1px solid #48515d;
    border-radius: 5px;
    padding: 5px 7px;
    selection-background-color: #224b7a;
    color: #e6edf3;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #6ba5ff;
}
QPushButton {
    background: #252a31;
    border: 1px solid #48515d;
    border-radius: 6px;
    padding: 6px 12px;
    color: #e6edf3;
}
QPushButton:hover {
    background: #2f3947;
    border: 1px solid #6ba5ff;
}
QTableView {
    background: #11161c;
    alternate-background-color: #171c23;
    gridline-color: #2f3742;
    border: 1px solid #3a404a;
    selection-background-color: #224b7a;
    selection-color: #ffffff;
}
QHeaderView::section {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2b3139, stop:1 #242a31);
    color: #d9e2ec;
    border: 1px solid #3a404a;
    padding: 4px;
    font-weight: 600;
}
QTabBar::tab {
    background: #2b3139;
    color: #d9e2ec;
    border: 1px solid #3a404a;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 7px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #1f2329;
    color: #7db4ff;
    border: 1px solid #5e7ea4;
    border-bottom: 2px solid #1f2329;
}
QStatusBar {
    background: #252a31;
    border-top: 1px solid #3a404a;
}
